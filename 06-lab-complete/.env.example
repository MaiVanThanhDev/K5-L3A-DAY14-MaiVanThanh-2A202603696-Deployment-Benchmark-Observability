# ============================================================
# Biến môi trường của agent. Dùng: cp .env.example .env rồi điền giá trị.
# File .env nằm trong .gitignore — KHÔNG commit secret thật.
# Trên Railway / Render: đặt các biến này trong phần Variables / Environment.
# ============================================================

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
WEB_CONCURRENCY=2

# Security — bắt buộc khi ENVIRONMENT=production (tạo bằng: openssl rand -hex 32)
AGENT_API_KEY=

# State store (rate limit + cost guard)
REDIS_URL=redis://localhost:6379/0

# Rate limit: số request tối đa mỗi 60 giây cho một API key
RATE_LIMIT_PER_MINUTE=10

# Cost guard (USD) — <= 0 nghĩa là không giới hạn theo kỳ đó
DAILY_BUDGET_USD=0
MONTHLY_BUDGET_USD=10
